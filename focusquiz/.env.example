# Copy this file to .env in the project root. Every value is optional.

# AI-generated questions. Without a key the app falls back to local practice questions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Session history. Without these the server stores sessions in server/data/sessions.json.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

PORT=8787
